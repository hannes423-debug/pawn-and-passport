{
  "password": { "minLength": 10, "maxLength": 256 },
  "session": { "days": 30, "extendAfterMinutes": 60 },
  "reset": { "expiresMinutes": 60 },
  "rateLimits": {
    "login":    { "perIp": [20, 900],  "perEmail": [8, 900] },
    "register": { "perIp": [10, 3600] },
    "reset":    { "perIp": [10, 3600], "perEmail": [3, 3600] }
  }
}
