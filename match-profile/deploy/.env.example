# Chess Match Profile - environment for the Raspberry Pi (copy to match-profile/.env).
# Secrets live here and nowhere else. Never commit the real file.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100
# The address people use: what `tailscale funnel 3100` prints.
PUBLIC_URL=https://your-pi.your-tailnet.ts.net
DATABASE_PATH=data/chess-match-profile.db
LOG_LEVEL=info

# Native Stockfish for play and analysis (arm64 build on the Pi).
STOCKFISH_PATH=/usr/games/stockfish
ANALYSIS_CONCURRENCY=1

# Password-reset email. Leave SMTP_HOST empty to log reset links to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# NOT here: MASTER_EMAIL / MASTER_PASSWORD. They are passed once, on the
# command line, to `npm run create-master`, and the server never reads them.
